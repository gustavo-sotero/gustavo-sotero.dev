{
  "name": "@portfolio/api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file ../../.env --watch src/index.ts",
    "start": "bun run --env-file ../../.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "bunx tsc --noEmit -p tsconfig.json && bun ../../scripts/build-service-runtime.ts apps/api",
    "db:generate": "bunx drizzle-kit generate",
    "db:seed": "bun run --env-file ../../.env src/db/seed.ts",
    "db:reset": "bun run --env-file ../../.env src/db/reset.ts",
    "db:migrate": "bun run --env-file ../../.env src/db/migrate.ts",
    "db:audit:schema": "bun run --env-file ../../.env src/db/audit-schema-parity.ts",
    "db:backfill:comments": "bun run --env-file ../../.env src/db/backfill-comment-rendered-content.ts",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@logtape/file": "^2.3.3",
    "@logtape/hono": "^2.3.3",
    "@logtape/logtape": "^2.3.3",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@portfolio/shared": "workspace:*",
    "@shikijs/rehype": "^4.4.3",
    "ai": "^7.0.93",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-shiki": "^0.0.9",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "hast": "^1.0.0",
    "hast-util-sanitize": "^5.0.2",
    "mdast": "^3.0.0",
    "unist": "^0.0.1",
    "vitest": "^5.0.0"
  }
}
